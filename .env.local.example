# ────────────────────────────────────────────────────────────
#  Variables d'environnement — site CRCI
#  En local : copiez ce fichier en ".env.local".
#  En production : Vercel > Projet > Settings > Environment Variables.
# ────────────────────────────────────────────────────────────

# Adresse publique du site (sert au sitemap et aux aperçus de partage)
NEXT_PUBLIC_SITE_URL=https://crci-nextjs.vercel.app

# Sanity (gestion des actualités et de la galerie)
NEXT_PUBLIC_SANITY_PROJECT_ID=musxunr9
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Envoi des formulaires (contact, volontariat, dons) par e-mail
# Paramètres SMTP de la boîte qui envoie (fournis par l'hébergeur de la messagerie)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché (facultatif) et destinataire des formulaires
MAIL_FROM="Site CRCI <no-reply@croix-rougeci.org>"
MAIL_TO=info@croix-rougeci.org
