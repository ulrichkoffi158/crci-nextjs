# ────────────────────────────────────────────────────────────
#  Variables d'environnement Sanity CMS — CRCI Next.js
#  Copiez ce fichier en ".env.local" et remplissez les valeurs
# ────────────────────────────────────────────────────────────

# Obligatoire — Récupérez-le sur https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=votre_project_id_ici

# Dataset (laissez "production" par défaut)
NEXT_PUBLIC_SANITY_DATASET=production

# Version API Sanity (ne pas modifier)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optionnel — Token en lecture pour les données non publiées (drafts)
# À créer dans Sanity > API > Tokens (rôle Viewer)
# SANITY_API_READ_TOKEN=votre_token_ici
